    SAI PHÂN TRUNG TÂM CẤP 2 
import numpy as np

# P4: Phương pháp sai phân trung tâm cấp 2
def diff_center(f, x, h, order=2) -> float:
    """
    Tên thuật toán: Phương pháp sai phân trung tâm cấp 2

    require:
        f: Hàm số cần tính đạo hàm (callable function)
        x: Điểm cần tính đạo hàm (float hoặc int)
        h: Bước lưới (số thực dương)
        order: Cấp sai phân (Cấp 2)

    ensure:
        float: Giá trị gần đúng của đạo hàm cấp 2 tại điểm x
    """

    # 1. Kiểm tra bước lưới
    if h <= 0:
        raise ValueError("h phai lon hon 0")

    # 2. Kiểm tra điểm tính
    if x - h <= 0:
        raise ValueError("Can kiem tra mien xac dinh cua ham")

    # 3. Công thức tính đạo hàm
    result = (f(x-h) - 2*f(x) + f(x+h)) / h**2

    return result
