import numpy as np

def diff_center_2(f, x, h):
    #1. Kiem tra buoc luoi
    if h <= 0:
        raise ValueError("h phai lon hon 0")

    #2. Kiem tra diem tinh của
    if x - h <= 0:
        raise ValueError("Can kiem tra mien xac dinh cua ham")

    #3. Tinh dao ham cap 2 sai phan trung tam
    result = (f(x + h) - 2*f(x) + f(x - h)) / h**2

    return result

# vi du hàm f(x) = e^(-x^2)
def f(x):
    return np.exp(-x**2)

# De bai 
x = 0.5
h = 0.1

# Tính đạo hàm cấp 2
result = diff_center_2(f, x, h)

print("Dao ham cap 2 bang sai phan trung tam tai  f''(0.5) =", result)
